/* Ultra-Net Dashboard — Dark Tech Theme */

QMainWindow {
    background-color: #0a0e14;
}
QWidget {
    background-color: #0a0e14;
    color: #bfc7d5;
    font-family: "Consolas", "Monaco", monospace;
    font-size: 12px;
}

/* ── Panel containers ─────────────────────────────────────────── */
QFrame#panel {
    background-color: #12171f;
    border: 1px solid #1a2332;
    border-radius: 6px;
    padding: 8px;
}

/* ── Labels ────────────────────────────────────────────────────── */
QLabel#title {
    color: #39bae6;
    font-size: 14px;
    font-weight: bold;
}
QLabel#value {
    color: #ffcc66;
    font-size: 18px;
    font-weight: bold;
}
QLabel#metric_label {
    color: #5c6773;
    font-size: 10px;
}
QLabel#status_online {
    color: #7fd962;
    font-weight: bold;
}
QLabel#status_offline {
    color: #f26d78;
    font-weight: bold;
}

/* ── Status bar ────────────────────────────────────────────────── */
QStatusBar {
    background-color: #0d1117;
    color: #5c6773;
    border-top: 1px solid #1a2332;
}

/* ── Group box ──────────────────────────────────────────────────── */
QGroupBox {
    color: #39bae6;
    font-weight: bold;
    border: 1px solid #1a2332;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ── Table ─────────────────────────────────────────────────────── */
QTableView {
    background-color: #12171f;
    alternate-background-color: #161c26;
    gridline-color: #1a2332;
    selection-background-color: #1f3a4a;
    border: 1px solid #1a2332;
}
QHeaderView::section {
    background-color: #0d1117;
    color: #5c6773;
    border: none;
    padding: 4px;
}

/* ── Chart ─────────────────────────────────────────────────────── */
QChartView {
    background-color: transparent;
    border: none;
}

/* ── Scroll bar ─────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #0d1117;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #1a2332;
    border-radius: 3px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── Tool tip ──────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a2332;
    color: #bfc7d5;
    border: 1px solid #39bae6;
    padding: 4px;
}
